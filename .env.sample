# Settings of compose.yaml: copy to .env (see docs/SELF-HOSTING.md)

# e-mail address or website URL sent in the User-Agent: required with Transitous (usage policy)
MOTIS_APP_CONTACT=you@example.org

# image tag of the published images (default: latest)
#MOTIS_MCP_APP_VERSION=latest

# MCP server (see docs/MCP-SERVER.md)
#MOTIS_BASE_URL=https://api.transitous.org/
#MOTIS_LOG_LEVEL=NONE
#MOTIS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MOTIS_TILE_ATTRIBUTION=
# dedicated origin of the views on /mcp/<host> (see docs/MCP-SERVER.md)
#MOTIS_VIEW_DOMAIN_CHATGPT=
#MOTIS_VIEW_DOMAIN_CLAUDE=
#MOTIS_VIEW_DOMAIN_MISTRAL=
#MOTIS_VIEW_DOMAIN_CHERRY=
#MCP_ALLOWED_HOSTS=

# web chat: public URLs, as seen by the browser
#MCP_URL=http://localhost:3001/mcp
#APP_ORIGIN=http://localhost:8080
#SANDBOX_ORIGIN=http://localhost:8081
